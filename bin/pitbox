#!/usr/bin/env bash
# pitbox: fixed pool of git worktree slots for parallel agent tasks.
#
# Global tool, repo-specific behavior lives in .pitbox/ inside each repository:
#   .pitbox/config       shell vars: MAIN_BRANCH, READY_MODE, EVIDENCE, REQUIRE_PUSH
#   .pitbox/setup.sh     called with the slot dir as $1 after worktree add and on release
#   .pitbox/release.sh   optional, called with the slot dir as $1 on release
#
# Slot state lives in the common git dir, shared by every worktree:
#   pitbox/slots/<name>.path       registered worktree path of the slot
#   pitbox/slots/<name>.ready      readiness marker (branch, commit, notes)
#   pitbox/slots/<name>.collected  set after the branch was merged by collect
#
# Requires git 2.31+ (--path-format) and bash.
set -Eeuo pipefail

VERSION="0.4.3"

usage() {
    cat <<EOF
pitbox $VERSION: fixed pool of git worktree slots for parallel agent tasks

Usage (run anywhere inside the repository):
  pitbox init [--stack S] [--force]   Write .pitbox/ templates
  pitbox setup [N]              Create slot worktrees wt1..wtN (default 3), run .pitbox/setup.sh in each
  pitbox claim [slot|branch-name] [branch-name]  Book a free slot and create the task branch (auto-picks a slot)
  pitbox status                 Show slots: branch, dirty files, commits ahead of main, state, policy
  pitbox ready <slot> [note]    Mark the slot's task ready (refuses dirty or empty slots)
  pitbox collect <slot|ready>   Merge the slot branch into the main branch (--no-ff)
  pitbox release <slot>         Reset the slot to main, delete the merged branch, run release hooks
  pitbox guide                  Print the workflow rules for this repository, rendered from .pitbox/config
  pitbox mcp                    Start the MCP server (needs the mcp/server.mjs from the repository)
  pitbox version                Print the version
  pitbox help                   Show this help

Repository configuration (committed alongside the code):
  .pitbox/config                shell vars:
                                  MAIN_BRANCH=<branch>
                                  READY_MODE=auto|confirm   auto: commit and mark ready without waiting
                                                            for review (default). confirm: commit always,
                                                            mark ready only after user confirmation.
                                  EVIDENCE=auto|screenshot|requests|none
                                                            what slot agents show as proof of work (default auto)
                                  REQUIRE_PUSH=1            demand pushed branches on ready
                                  INTEGRATE_CHECKS=auto|full|ci
                                                            auto (default): run the repository's full checks
                                                            only after a merge with manually resolved
                                                            conflicts. full: always before deploy.
                                                            ci: never locally, push and let CI verify.
  .pitbox/setup.sh              install deps in a fresh slot (bun install, composer install, ...)
  .pitbox/release.sh            extra cleanup on release (defaults to setup.sh)

In slot mode the .pitbox/config delivery policy overrides the repository's AGENTS.md delivery
rules. INTEGRATE_CHECKS decides when the integrator's checks run, AGENTS.md only names the
check and deploy commands. pitbox never reads or edits AGENTS.md. The user's word always
overrides the marker.
EOF
}

die() { echo "pitbox: $*" >&2; exit 1; }

main_worktree() {
    git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
    git worktree list --porcelain | sed -n 's/^worktree //p' | head -1
}

git_common_dir() {
    git -C "$1" rev-parse --path-format=absolute --git-common-dir
}

state_dir() {
    echo "$(git_common_dir "$1")/pitbox/slots"
}

marker_file() {
    echo "$(state_dir "$1")/$2.ready"
}

collected_file() {
    echo "$(state_dir "$1")/$2.collected"
}

conflict_file() {
    echo "$(state_dir "$1")/$2.conflict"
}

registry_file() {
    echo "$(state_dir "$1")/$2.path"
}

lock_dir() {
    echo "$(git_common_dir "$1")/pitbox/claim.lock"
}

load_config() {
    local root="$1"
    MAIN_BRANCH=""
    READY_MODE="auto"
    EVIDENCE="auto"
    if [[ -f "$root/.pitbox/config" ]]; then
        # shellcheck disable=SC1091
        source "$root/.pitbox/config"
    fi
    REQUIRE_PUSH="${REQUIRE_PUSH:-0}"
    READY_MODE="${READY_MODE:-auto}"
    EVIDENCE="${EVIDENCE:-auto}"
    INTEGRATE_CHECKS="${INTEGRATE_CHECKS:-auto}"
    case "$READY_MODE" in
        auto|confirm) ;;
        *) die "invalid READY_MODE: $READY_MODE (supported: auto, confirm)" ;;
    esac
    case "$EVIDENCE" in
        auto|screenshot|requests|none) ;;
        *) die "invalid EVIDENCE: $EVIDENCE (supported: auto, screenshot, requests, none)" ;;
    esac
    case "$INTEGRATE_CHECKS" in
        auto|full|ci) ;;
        *) die "invalid INTEGRATE_CHECKS: $INTEGRATE_CHECKS (supported: auto, full, ci)" ;;
    esac
    case "$REQUIRE_PUSH" in
        0|1) ;;
        *) die "invalid REQUIRE_PUSH: $REQUIRE_PUSH (supported: 0, 1)" ;;
    esac
    if [[ -z "${MAIN_BRANCH}" ]]; then
        MAIN_BRANCH="$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || MAIN_BRANCH=""
    fi
    if [[ -z "${MAIN_BRANCH}" ]]; then
        MAIN_BRANCH="$(git -C "$root" branch --show-current)"
    fi
    [[ -n "${MAIN_BRANCH}" ]] || die "cannot determine the main branch, set MAIN_BRANCH in .pitbox/config"
    bootstrap_slots "$root"
}

register_slot() {
    local root="$1" name="$2" dir="$3"
    mkdir -p "$(state_dir "$root")"
    echo "$dir" > "$(registry_file "$root" "$name")"
}

# Pre-0.4 pools kept slots as sibling directories with no registry. Register any
# sibling worktree matching the old naming once, then the registry is the only source.
bootstrap_slots() {
    local root="$1" state base bn name wt
    state="$(state_dir "$root")"
    if [[ -d "$state" ]] && compgen -G "$state/*.path" >/dev/null; then
        return 0
    fi
    base="$(basename "$root")"
    while IFS= read -r wt; do
        bn="$(basename "$wt")"
        if [[ "$bn" =~ ^${base}-wt[0-9]+$ ]]; then
            name="${bn#"$base"-}"
            register_slot "$root" "$name" "$wt"
        fi
    done < <(git -C "$root" worktree list --porcelain | sed -n 's/^worktree //p')
}

slot_names() {
    local root="$1" state f
    state="$(state_dir "$root")"
    [[ -d "$state" ]] || return 0
    for f in "$state"/*.path; do
        [[ -f "$f" ]] || continue
        basename "$f" .path
    done | sort -V
}

slot_dir() {
    local root="$1" name="$2" f
    f="$(registry_file "$root" "$name")"
    [[ -f "$f" ]] || return 0
    cat "$f"
}

slot_state() {
    local root="$1" name="$2" dir="$3"
    if [[ -z "$dir" || ! -d "$dir" ]]; then
        echo "missing"
    elif [[ -f "$(collected_file "$root" "$name")" ]]; then
        echo "collected"
    elif [[ -f "$(marker_file "$root" "$name")" ]]; then
        echo "ready"
    else
        echo "work"
    fi
}

run_hook() {
    local root="$1" hook="$2" dir="$3"
    if [[ -f "$root/.pitbox/$hook" ]]; then
        echo "pitbox: running .pitbox/$hook in $dir"
        bash "$root/.pitbox/$hook" "$dir"
    fi
}

dirty_count() {
    local out
    out="$(git -C "$1" status --porcelain -- . ':(exclude)TASK_READY.md' 2>/dev/null)" || { echo "?"; return 0; }
    if [[ -z "$out" ]]; then
        echo 0
    else
        printf '%s\n' "$out" | wc -l | tr -d ' '
    fi
}

# A pre-0.4 readiness marker is an untracked TASK_READY.md in the slot root.
# Import it into the pitbox state once, then the state dir is the only marker.
import_legacy_marker() {
    local root="$1" name="$2" dir="$3" marker legacy branch commit updated notes
    marker="$(marker_file "$root" "$name")"
    if [[ -f "$marker" ]]; then
        return 0
    fi
    legacy="$dir/TASK_READY.md"
    if [[ ! -f "$legacy" ]]; then
        return 0
    fi
    branch="$(sed -n 's/^branch: //p' "$legacy")"
    commit="$(sed -n 's/^commit: //p' "$legacy")"
    updated="$(sed -n 's/^updated: //p' "$legacy")"
    notes="$(sed -n 's/^notes: //p' "$legacy")"
    mkdir -p "$(state_dir "$root")"
    {
        echo "branch: $branch"
        echo "slot: $name"
        echo "commit: $commit"
        echo "updated: ${updated:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
        echo "notes: ${notes:-none}"
    } > "$marker"
    rm -f "$legacy"
    echo "pitbox: imported legacy TASK_READY.md for $name into the pitbox state"
}

acquire_lock() {
    local lock="$1" pid
    mkdir -p "$(dirname "$lock")"
    if mkdir "$lock" 2>/dev/null; then
        echo $$ > "$lock/pid"
        return 0
    fi
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -z "$pid" ]] || ! ps -p "$pid" >/dev/null 2>&1; then
        echo "pitbox: stealing stale claim lock from dead process ${pid:-unknown}" >&2
        rm -rf "$lock"
        if mkdir "$lock" 2>/dev/null; then
            echo $$ > "$lock/pid"
            return 0
        fi
    fi
    die "another claim is in progress (pid ${pid:-unknown}), remove $lock if it is stale"
}

claim_one() {
    local root="$1" name="$2" branch="$3" dir cur slot_head main_head dirty
    dir="$(slot_dir "$root" "$name")"
    [[ -n "$dir" && -d "$dir" ]] || die "no such slot: $name"
    cur="$(git -C "$dir" branch --show-current)"
    [[ "$cur" == "slot/$name" ]] || die "slot $name is busy on $cur, pick another slot"
    dirty="$(dirty_count "$dir")"
    [[ "$dirty" == 0 ]] || die "slot $name has $dirty uncommitted files, clean it before claiming"
    import_legacy_marker "$root" "$name" "$dir"
    [[ ! -f "$(marker_file "$root" "$name")" ]] || die "slot $name has a stale readiness marker, release it before claiming"
    # A collected marker without a release is stale by definition, claiming clears it.
    rm -f "$(collected_file "$root" "$name")"
    slot_head="$(git -C "$dir" rev-parse HEAD)"
    main_head="$(git -C "$root" rev-parse "$MAIN_BRANCH")"
    if [[ "$slot_head" != "$main_head" ]]; then
        git -C "$dir" checkout -q -B "slot/$name" "$MAIN_BRANCH" || die "cannot sync slot $name to $MAIN_BRANCH"
        run_hook "$root" "setup.sh" "$dir"
    fi
    git -C "$dir" checkout -q -b "$branch" 2>/dev/null || die "cannot create branch $branch in $name, it already exists?"
    echo "pitbox: claimed $name for $branch at $dir"
}

cmd_claim() {
    local root want="" name="" free s has_slot=0
    root="$(main_worktree)"
    load_config "$root"
    case $# in
        0) ;;
        1)
            if [[ "$1" =~ ^wt[0-9]+$ ]]; then
                want="$1"
            else
                name="$1"
            fi
            ;;
        2) want="$1"; name="$2" ;;
        *) die "usage: pitbox claim [slot|branch-name] [branch-name]" ;;
    esac
    [[ -n "$name" ]] || name="task/$(date -u +%Y%m%d-%H%M%S)"
    # Deliberately global so the single-quoted EXIT trap below still sees it.
    lock="$(lock_dir "$root")"
    acquire_lock "$lock"
    trap 'rm -rf "$lock" 2>/dev/null || true' EXIT
    if [[ -n "$want" ]]; then
        claim_one "$root" "$want" "$name"
    else
        free=""
        for s in $(slot_names "$root"); do
            has_slot=1
            if [[ "$(git -C "$(slot_dir "$root" "$s")" branch --show-current)" == "slot/$s" ]]; then
                free="$s"
                break
            fi
        done
        if [[ -z "$free" ]]; then
            [[ "$has_slot" == 1 ]] || die "no slots yet, run: pitbox setup"
            die "no free slot, wait for a slot to be released"
        fi
        claim_one "$root" "$free" "$name"
    fi
}

cmd_setup() {
    local root count name dir
    root="$(main_worktree)"
    load_config "$root"
    count="${1:-3}"
    [[ "$count" =~ ^[0-9]+$ ]] || die "setup takes a number, got: $count"
    lock="$(lock_dir "$root")"
    acquire_lock "$lock"
    trap 'rm -rf "$lock" 2>/dev/null || true' EXIT
    for i in $(seq 1 "$count"); do
        name="wt$i"
        dir="$(dirname "$root")/$(basename "$root")-$name"
        if [[ -d "$dir" ]]; then
            echo "pitbox: $name already exists at $dir"
        else
            if git -C "$root" rev-parse --verify --quiet "refs/heads/slot/$name" >/dev/null; then
                git -C "$root" worktree add "$dir" "slot/$name"
            else
                git -C "$root" worktree add -b "slot/$name" "$dir" "$MAIN_BRANCH"
            fi
            run_hook "$root" "setup.sh" "$dir"
        fi
        register_slot "$root" "$name" "$dir"
    done
}

cmd_status() {
    local root name dir branch dirty ahead state any=0
    root="$(main_worktree)"
    load_config "$root"
    echo "main branch: $MAIN_BRANCH    main worktree: $root"
    echo "policy: ready=$READY_MODE evidence=$EVIDENCE push=$( [[ "$REQUIRE_PUSH" == "1" ]] && echo on || echo off ) checks=$INTEGRATE_CHECKS"
    printf '%-6s %-28s %-7s %-7s %-10s %s\n' "slot" "branch" "dirty" "ahead" "state" "path"
    for name in $(slot_names "$root"); do
        any=1
        dir="$(slot_dir "$root" "$name")"
        if [[ -n "$dir" && -d "$dir" ]]; then
            import_legacy_marker "$root" "$name" "$dir"
        fi
        state="$(slot_state "$root" "$name" "$dir")"
        branch="?"
        dirty="?"
        ahead="?"
        if [[ "$state" != "missing" ]]; then
            branch="$(git -C "$dir" branch --show-current 2>/dev/null)" || branch="?"
            dirty="$(dirty_count "$dir")"
            ahead="$(git -C "$dir" rev-list --count "$MAIN_BRANCH..HEAD" 2>/dev/null)" || ahead="?"
        fi
        printf '%-6s %-28s %-7s %-7s %-10s %s\n' "$name" "$branch" "$dirty" "$ahead" "$state" "${dir:-unknown}"
    done
    [[ "$any" == 1 ]] || echo "no slots yet, run: pitbox setup"
}

cmd_ready() {
    local root name dir branch dirty ahead note unpushed
    root="$(main_worktree)"
    load_config "$root"
    name="${1:-}"
    shift || true
    note="$*"
    [[ -n "$name" ]] || die "usage: pitbox ready <slot> [note]"
    dir="$(slot_dir "$root" "$name")"
    [[ -n "$dir" && -d "$dir" ]] || die "no such slot: $name"
    import_legacy_marker "$root" "$name" "$dir"
    branch="$(git -C "$dir" branch --show-current)"
    [[ "$branch" != "slot/$name" ]] || die "slot $name has no task branch, create one before marking ready"
    dirty="$(dirty_count "$dir")"
    [[ "$dirty" == 0 ]] || die "slot $name has $dirty uncommitted files, commit first"
    if [[ "$REQUIRE_PUSH" == "1" ]]; then
        git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 \
            || die "slot $name branch $branch has no upstream, push it first"
        unpushed="$(git -C "$dir" rev-list --count '@{u}..HEAD')"
        [[ "$unpushed" == 0 ]] || die "slot $name has $unpushed unpushed commits, push before marking ready"
    fi
    ahead="$(git -C "$dir" rev-list --count "$MAIN_BRANCH..HEAD")"
    [[ "$ahead" != 0 ]] || die "slot $name has no commits ahead of $MAIN_BRANCH"
    mkdir -p "$(state_dir "$root")"
    cat > "$(marker_file "$root" "$name")" <<EOF
branch: $branch
slot: $name
commit: $(git -C "$dir" rev-parse HEAD)
updated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
notes: ${note:-none}
EOF
    # Re-readying after a collection (feedback round) re-arms the slot.
    rm -f "$(collected_file "$root" "$name")"
    echo "pitbox: $name marked ready ($branch, $ahead commits ahead of $MAIN_BRANCH)"
    if [[ "$READY_MODE" == "confirm" ]]; then
        echo "pitbox: policy READY_MODE=confirm, mark ready only after the user confirmed the result"
    fi
}

cmd_collect() {
    local root target name dir any=0
    root="$(main_worktree)"
    load_config "$root"
    target="${1:-}"
    [[ -n "$target" ]] || die "usage: pitbox collect <slot|ready>"
    collect_one() {
        local name="$1" marked="$2" dir branch mb dmain mbranch mcommit cur
        dir="$(slot_dir "$root" "$name")"
        if [[ -z "$dir" || ! -d "$dir" ]]; then
            echo "pitbox: skipping $name (missing slot directory)"
            return 0
        fi
        branch="$(git -C "$dir" branch --show-current)"
        if [[ "$branch" == "slot/$name" ]]; then
            echo "pitbox: skipping $name (no task branch)"
            return 0
        fi
        if [[ -f "$(collected_file "$root" "$name")" ]]; then
            echo "pitbox: $name already collected, run: pitbox release $name"
            return 0
        fi
        mb="$(git -C "$root" branch --show-current)"
        [[ "$mb" == "$MAIN_BRANCH" ]] || die "main worktree is on $mb, collect merges into $MAIN_BRANCH, switch it first"
        dmain="$(dirty_count "$root")"
        [[ "$dmain" == 0 ]] || die "main checkout has $dmain uncommitted files, clean it before collecting"
        import_legacy_marker "$root" "$name" "$dir"
        if [[ -f "$(marker_file "$root" "$name")" ]]; then
            mbranch="$(sed -n 's/^branch: //p' "$(marker_file "$root" "$name")")"
            mcommit="$(sed -n 's/^commit: //p' "$(marker_file "$root" "$name")")"
            cur="$(git -C "$dir" rev-parse HEAD)"
            [[ "$mbranch" == "$branch" ]] || die "slot $name switched from $mbranch to $branch after being marked ready"
            if [[ -n "$mcommit" && "$mcommit" != "$cur" ]]; then
                die "slot $name changed after being marked ready ($mcommit, now $cur), re-run pitbox ready $name"
            fi
        elif [[ -z "$marked" ]]; then
            echo "pitbox: warning: $name has no readiness marker, collecting anyway (the user's word overrides the marker)"
        fi
        echo "pitbox: merging $branch from $name into $MAIN_BRANCH"
        if ! git -C "$root" merge --no-ff "$branch" -m "Merge $branch from $name"; then
            mkdir -p "$(state_dir "$root")"
            {
                echo "conflicts: unresolved"
                echo "commit: $(git -C "$dir" rev-parse HEAD)"
            } > "$(conflict_file "$root" "$name")"
            die "merge of $branch stopped with conflicts, resolve them in the main checkout, commit, then re-run this collect and continue with the remaining slots"
        fi
        local conflicted=0
        if [[ -f "$(conflict_file "$root" "$name")" && "$(sed -n 's/^commit: //p' "$(conflict_file "$root" "$name")")" == "$(git -C "$dir" rev-parse HEAD)" ]]; then
            conflicted=1
        fi
        mkdir -p "$(state_dir "$root")"
        {
            echo "branch: $branch"
            echo "slot: $name"
            echo "commit: $(git -C "$root" rev-parse HEAD)"
            echo "updated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
            if [[ "$conflicted" == 1 ]]; then
                echo "conflicts: resolved"
            fi
        } > "$(collected_file "$root" "$name")"
        rm -f "$(marker_file "$root" "$name")" "$(conflict_file "$root" "$name")"
        if [[ "$conflicted" == 1 ]]; then
            echo "pitbox: $name merged with manually resolved conflicts, the resolution code was never tested, run the repository's full checks before deploy"
        fi
        case "$INTEGRATE_CHECKS" in
            ci)
                echo "pitbox: $name collected, push and let CI verify the merged main, deploy when green, then: pitbox release $name"
                ;;
            full)
                echo "pitbox: $name collected, run the full checks, deploy, push, then: pitbox release $name"
                ;;
            *)
                if [[ "$conflicted" == 1 ]]; then
                    echo "pitbox: $name collected, run the full checks first, then deploy, push, and: pitbox release $name"
                else
                    echo "pitbox: $name collected cleanly, push and run: pitbox release $name (deploy after CI is green, or now without CI)"
                fi
                ;;
        esac
    }
    if [[ "$target" == "ready" ]]; then
        for name in $(slot_names "$root"); do
            dir="$(slot_dir "$root" "$name")"
            if [[ -n "$dir" && ( -f "$(marker_file "$root" "$name")" || -f "$(collected_file "$root" "$name")" || -f "$dir/TASK_READY.md" ) ]]; then
                any=1
                collect_one "$name" 1
            fi
        done
        [[ "$any" == 1 ]] || echo "pitbox: no ready slots found"
    else
        collect_one "$target" 0
    fi
}

cmd_release() {
    local root name dir branch marker collected
    root="$(main_worktree)"
    load_config "$root"
    name="${1:-}"
    [[ -n "$name" ]] || die "usage: pitbox release <slot>"
    dir="$(slot_dir "$root" "$name")"
    [[ -n "$dir" && -d "$dir" ]] || die "no such slot: $name"
    import_legacy_marker "$root" "$name" "$dir"
    marker="$(marker_file "$root" "$name")"
    collected="$(collected_file "$root" "$name")"
    if [[ -f "$marker" && ! -f "$collected" ]]; then
        echo "pitbox: warning: $name was ready but never collected, make sure the branch was merged"
    fi
    branch="$(git -C "$dir" branch --show-current)"
    git -C "$dir" checkout -B "slot/$name" "$MAIN_BRANCH"
    if [[ "$branch" != "slot/$name" ]]; then
        if git -C "$root" branch -d "$branch" 2>/dev/null; then
            echo "pitbox: deleted merged branch $branch"
        else
            echo "pitbox: branch $branch is not fully merged, keeping it"
        fi
    fi
    rm -f "$marker" "$collected" "$(conflict_file "$root" "$name")" "$dir/TASK_READY.md"
    if [[ -f "$root/.pitbox/release.sh" ]]; then
        run_hook "$root" "release.sh" "$dir"
    else
        run_hook "$root" "setup.sh" "$dir"
    fi
    echo "pitbox: $name released, now on slot/$name at $MAIN_BRANCH"
}

cmd_mcp() {
    local self dir server
    self="${BASH_SOURCE[0]}"
    dir="$(cd "$(dirname "$self")" && pwd)"
    server="$dir/../mcp/server.mjs"
    if [[ -f "$server" ]]; then
        exec node "$server"
    fi
    die "mcp/server.mjs not found next to the CLI, clone the pitbox repository or run the server directly: node /path/to/pitbox/mcp/server.mjs"
}

cmd_guide() {
    local root push_label="off"
    root="$(main_worktree)"
    load_config "$root"
    if [[ "$REQUIRE_PUSH" == "1" ]]; then
        push_label="on"
    fi
    cat <<EOF
pitbox workflow guide

policy: ready=$READY_MODE evidence=$EVIDENCE push=$push_label checks=$INTEGRATE_CHECKS
Source of truth: in slot mode this policy overrides the repository's AGENTS.md delivery rules. INTEGRATE_CHECKS decides when the integrator's checks run, AGENTS.md only names the check and deploy commands. pitbox never reads or edits AGENTS.md.

Modes:
- One task: work directly in the main checkout.
- Two or three parallel tasks: one per slot (wt1..wtN), the main checkout is reserved for the integrator, a separate conversation from the slot workers.

Slot agents:
- Start with: pitbox claim [branch-name]. It books a free slot atomically and creates your task branch in it. Pass a slot number only if the user specified one.
- Never pick a slot from status and create branches by hand, two agents can race for the same slot.
- Verify inside the slot, commit only the task files, then run pitbox ready <slot> [notes]. ready records a handoff marker and never merges, deploys, or starts collection.
EOF
    if [[ "$READY_MODE" == "confirm" ]]; then
        echo "- Commit your work as soon as it is verified. Run pitbox ready only after the user explicitly confirms the result."
    else
        echo "- Commit and mark ready as soon as your checks pass. Do not wait for user review or approval, the user reviews the ready slot and asks for collection when satisfied."
    fi
    case "$EVIDENCE" in
        screenshot)
            echo "- Prove visual work with a screenshot from the local preview, displayed in the result. A localhost link alone is not reviewable for a remote user."
            ;;
        requests)
            echo "- Prove the change with a request and response example (curl or test output) in the result."
            ;;
        none)
            echo "- Describe in text what you changed and how you verified it."
            ;;
        auto)
            echo "- Prove the result: a screenshot from the local preview for UI work, a request and response example (curl or test output) for backend work, a short written description for logic or config. A localhost link alone is not reviewable for a remote user."
            ;;
    esac
    cat <<'EOF'
- If the user gives feedback on the same ready task before collection, stay in that slot, commit the fix, and run ready again. For a new task after collection and release, check status and run pitbox claim without a slot number. A separate new task before collection also needs its own free slot.
- Never merge into the main branch, never deploy, never touch other slots. Finish with ready: this conversation is a worker, never the integrator.

Integrator (only on the user's explicit command, never just because a slot is ready):
- Integrate only from a conversation with no slot work in it: a fresh session, another agent, or the user's own terminal. If the user asks to collect in a conversation that did the slot work, decline and point them here.
- pitbox status, then collect ready slots: pitbox collect <slot|ready>. Collected slots are skipped until released.
- collect refuses when the main worktree is off the main branch, when it is dirty, or when a slot changed after its marker.
EOF
    if [[ "$INTEGRATE_CHECKS" == "ci" ]]; then
        echo "- Checks belong to CI: push the merged main and let CI verify it instead of running the full suite locally. If CI is red, fix forward or revert before new slots claim from main."
        echo "- Deploy once when CI is green, following the repository's AGENTS.md. Releasing the slots right after the push is fine, hold them until green only if a red main would poison new tasks."
    elif [[ "$INTEGRATE_CHECKS" == "full" ]]; then
        echo "- Run the repository's full checks, then deploy once following the repository's AGENTS.md."
        echo "- Push the main branch, then pitbox release <slot> for each collected slot."
    else
        echo "- Clean merges need no local full run: the slot agents verified their branches and a clean merge adds no untested code. Push the main branch and release the slots right away, the pool never waits for CI. Deploy once per the repository's AGENTS.md, after CI is green when one exists, straight away otherwise."
        echo "- When collect reports a slot merged with manually resolved conflicts, run the repository's full checks before deploy. The resolution code was never tested anywhere."
    fi
    cat <<'EOF'

Rules:
- The user's word always overrides the marker.
- In slot mode, defer repository deploy-before-commit requirements to the integrator. Slot agents verify, commit, and mark work ready per the policy above. User feedback can be handled as a follow-up fix. Direct work in the main checkout follows the repository's normal delivery order.
- A request to collect ready slots already authorizes collection. Do not ask for a second confirmation.
- If collect is refused for any reason, report it, do not force.
- Repository specifics: AGENTS.md in the repo root and the .pitbox/ hooks.
EOF
}

detect_stack() {
    local root="$1"
    if [[ -f "$root/composer.json" ]]; then
        echo "php-docker"
    elif [[ -f "$root/bun.lock" || -f "$root/bun.lockb" || -f "$root/package.json" ]]; then
        echo "bun"
    fi
}

template_config() {
    cat <<'EOF'
# pitbox configuration
# Main branch for slots; leave commented to autodetect (origin/HEAD, else current branch).
# MAIN_BRANCH=main
# Slot delivery policy. In slot mode it overrides the repository's AGENTS.md delivery rules.
# READY_MODE=auto                          auto (default): commit and mark ready without waiting
#                                          for review. confirm: commit always, mark ready only
#                                          after the user confirms the result.
# EVIDENCE=auto                            auto (default): screenshot for UI work, request and
#                                          response example for backend work, text for logic.
#                                          Other values: screenshot, requests, none.
# REQUIRE_PUSH=1                           demand pushed task branches on ready
# INTEGRATE_CHECKS=auto                    auto (default): run the full checks only after a merge
#                                          with manually resolved conflicts, clean merges go
#                                          straight to deploy and push. full: always run them
#                                          before deploy. ci: push and let CI be the gate.
EOF
}

template_bun() {
    local root="$1"
    template_config > "$root/.pitbox/config"
    cat > "$root/.pitbox/setup.sh" <<'EOF'
#!/usr/bin/env bash
# Installs dependencies in a slot worktree (arg $1) using the shared bun cache.
set -Eeuo pipefail
cd -- "$1"
bun install --frozen-lockfile
EOF
    cat > "$root/.pitbox/release.sh" <<'EOF'
#!/usr/bin/env bash
# Re-syncs a released slot (arg $1) with the merged main branch.
# Add build-artifact cleanup for this project below if needed.
set -Eeuo pipefail
cd -- "$1"
bun install --frozen-lockfile
EOF
}

template_php_docker() {
    local root="$1"
    template_config > "$root/.pitbox/config"
    cat > "$root/.pitbox/setup.sh" <<'EOF'
#!/usr/bin/env bash
# Prepares a slot worktree (arg $1) for a PHP + docker-compose project.
# Per-slot compose isolation needs: COMPOSE_PROJECT_NAME=<slot>, unique host
# ports, and no fixed container_name in compose files.
set -Eeuo pipefail
cd -- "$1"
command -v composer >/dev/null 2>&1 && composer install --no-interaction --no-progress
echo "pitbox: remember to set COMPOSE_PROJECT_NAME and unique ports before running compose in this slot"
EOF
    cat > "$root/.pitbox/release.sh" <<'EOF'
#!/usr/bin/env bash
# Resets a released slot (arg $1) for a PHP + docker-compose project.
set -Eeuo pipefail
cd -- "$1"
# docker compose -p <slot-project> down -v   # uncomment once per-slot project names are set
command -v composer >/dev/null 2>&1 && composer install --no-interaction --no-progress
EOF
}

cmd_init() {
    local root stack="" force=0
    root="$(main_worktree)"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --stack) stack="${2:-}"; shift 2 ;;
            --force) force=1; shift ;;
            *) die "init: unknown argument: $1" ;;
        esac
    done
    if [[ -d "$root/.pitbox" && "$force" != 1 ]]; then
        die ".pitbox already exists, use --force to overwrite"
    fi
    if [[ -z "$stack" ]]; then
        stack="$(detect_stack "$root")"
        [[ -n "$stack" ]] || die "cannot detect the stack, pass --stack bun or --stack php-docker"
    fi
    mkdir -p "$root/.pitbox"
    case "$stack" in
        bun) template_bun "$root" ;;
        php-docker) template_php_docker "$root" ;;
        *) die "unknown stack: $stack (supported: bun, php-docker)" ;;
    esac
    chmod +x "$root/.pitbox/setup.sh" "$root/.pitbox/release.sh"
    echo "pitbox: wrote $stack templates to $root/.pitbox/ (review and commit .pitbox/)"
}

case "${1:-help}" in
    init) shift; cmd_init "$@" ;;
    guide) cmd_guide ;;
    setup) shift; cmd_setup "$@" ;;
    claim) shift; cmd_claim "$@" ;;
    status) cmd_status ;;
    ready) shift; cmd_ready "$@" ;;
    collect) shift; cmd_collect "$@" ;;
    release) shift; cmd_release "$@" ;;
    mcp) cmd_mcp ;;
    version|--version|-V) echo "pitbox $VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "unknown command: $1" ;;
esac
