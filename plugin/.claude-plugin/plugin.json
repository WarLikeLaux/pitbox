  "description": "Handoff and integration protocol for parallel coding agents on a reusable worktree pool: MCP tools and one workflow skill for slot and integrator modes.",
  "author": { "name": "WarLikeLaux", "url": "https://github.com/WarLikeLaux" },
  "repository": "https://github.com/WarLikeLaux/pitbox",
  "license": "MIT",
  "keywords": ["mcp", "git", "worktree", "parallel", "agents"],
  "mcpServers": {
    "pitbox": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"]
    }
  }
}
